# Copy to .env.local. Base URL of the FastAPI backend (backend/), reached
# server-side only - by Server Components, Server Actions and route handlers.
API_URL=http://localhost:8000

# Public address of the site, for the sitemap, robots.txt and structured data.
# Defaults to https://liriu.vercel.app - set it when the custom domain goes live.
SITE_URL=

# Cloudflare Turnstile site key (public) for anti-spam on the order/contact
# forms. Empty = the widget is hidden and forms submit without it. Set it
# together with the backend's TURNSTILE_SECRET_KEY. Cloudflare's always-pass
# test site key is 1x00000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
