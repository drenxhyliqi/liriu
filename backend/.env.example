# Copy to .env for local (non-Docker) dev. docker-compose.yml at the repo
# root reads this same file for the `api` service.

DATABASE_URL=postgresql+psycopg2://liriu:liriu@localhost:5432/liriu
CORS_ORIGINS=http://localhost:3000

# "development" enables the interactive API docs at /docs. Leave unset (or set
# to "production") on the deployed backend so the docs and OpenAPI schema stay
# hidden.
ENVIRONMENT=development

# Generate a real one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-env
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Where uploaded images are stored (served at /media/...). Must be a
# persistent volume in production.
MEDIA_DIR=media

# New-order email notifications via Resend. Without a key, orders are still
# saved and only the email is skipped. MAIL_FROM must use a domain verified in
# Resend; onboarding@resend.dev only delivers to the Resend account's own email.
RESEND_API_KEY=
ORDER_NOTIFY_EMAILS=admin@example.com
MAIL_FROM=NSH LIRIU <onboarding@resend.dev>
SITE_URL=http://localhost:3000

# Used by docker-compose's `db` service only (Postgres' own bootstrap env
# vars, not read by the FastAPI app - it reads DATABASE_URL above instead).
POSTGRES_USER=liriu
POSTGRES_PASSWORD=liriu
POSTGRES_DB=liriu
