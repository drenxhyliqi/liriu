# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# backend (Python/FastAPI) - see backend/.env.example
backend/.env
# The template itself must ship: backend/README.md's setup step is
# `cp backend/.env.example backend/.env`, and the `.env*` rule above would
# otherwise ignore it. It holds placeholders only - never real values.
!backend/.env.example
backend/__pycache__/
backend/**/__pycache__/
backend/.venv/
backend/venv/
*.pyc

# Local scratch kept at the repo root while working - screenshots, reference
# exports, dropped media. Real site assets live in public/, so nothing at the
# root should be committed. Root-anchored so public/ is unaffected.
/*.png
/*.mp4

# Admin-uploaded images (runtime data, not source).
backend/media/

# Frontend env example (committed on purpose).
!.env.example
